{
  "name": "github-vscode-theme-modern",
  "displayName": "GitHub Theme (Modern)",
  "description": "GitHub theme for VS Code with Modern UI support",
  "version": "7.1.0",
  "publisher": "GitHub",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1b1f23",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/primer/github-vscode-theme"
  },
  "bugs": {
    "url": "https://github.com/primer/github-vscode-theme/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "github",
    "light",
    "dark",
    "protanopia",
    "colorblind",
    "modern"
  ],
  "contributes": {
    "themes": [
      {
        "label": "GitHub Light Default (Modern)",
        "uiTheme": "vs",
        "path": "./themes/light-default.json"
      },
      {
        "label": "GitHub Light High Contrast (Modern)",
        "uiTheme": "hc-light",
        "path": "./themes/light-high-contrast.json"
      },
      {
        "label": "GitHub Light Colorblind (Modern)",
        "uiTheme": "vs",
        "path": "./themes/light-colorblind.json"
      },
      {
        "label": "GitHub Dark Default (Modern)",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-default.json"
      },
      {
        "label": "GitHub Dark High Contrast (Modern)",
        "uiTheme": "hc-black",
        "path": "./themes/dark-high-contrast.json"
      },
      {
        "label": "GitHub Dark Colorblind (Modern)",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-colorblind.json"
      },
      {
        "label": "GitHub Dark Dimmed (Modern)",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-dimmed.json"
      },
      {
        "label": "GitHub Light (Modern)",
        "uiTheme": "vs",
        "path": "./themes/light.json"
      },
      {
        "label": "GitHub Dark (Modern)",
        "uiTheme": "vs-dark",
        "path": "./themes/dark.json"
      }
    ]
  },
  "devDependencies": {
    "@primer/primitives": "11.10.0",
    "@vscode/vsce": "^4.1.0",
    "chroma-js": "^3.2.0",
    "color": "^5.0.3",
    "nodemon": "^3.1.14"
  },
  "scripts": {
    "start": "nodemon --watch src src/index.js",
    "build": "node src/index.js",
    "package": "vsce package --no-yarn -o ./build/github-vscode-theme-modern.vsix",
    "prepublishOnly": "npm run build && vsce publish"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
